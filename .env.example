# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=
# Provider base URL override (for OpenAI-compatible gateways). Leave empty for api.openai.com.
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
# Demo app port
DEMO_APP_PORT=5007
# SNIFFING: set OPENAI_DRY_RUN=1 to run agent/replay with a scripted brain (no live API).
OPENAI_DRY_RUN=0